# Use Node.js 18 Bullseye as base
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# Copy package files and tsconfig
# FIX: Added package-lock.json explicitly to the tracking array so npm ci can evaluate it
COPY package*.json tsconfig.json ./

# Copy scripts and data
COPY scripts ./scripts
COPY .db ./.db

# FIX: Swapped npm install for npm ci to prevent runtime container process blocks
RUN npm ci

# Set environment variables
ENV NODE_ENV=development

# Command to run migration
CMD ["npx", "ts-node", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
