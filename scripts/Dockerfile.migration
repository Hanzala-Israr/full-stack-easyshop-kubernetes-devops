# Use Node.js 18 Bullseye as a stable runtime base
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# Copy the unignored folder from the host context
COPY migration_modules ./node_modules

# Copy the original TypeScript scripts and data directories
COPY scripts ./scripts
COPY .db ./.db

# Set target environment parameters
ENV NODE_ENV=development

# FAIL-PROOF EXECUTION: Runs ts-node natively out of your internal node_modules 
# to parse the original scripts/migrate-data.ts file directly!
CMD ["./node_modules/.bin/ts-node", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
