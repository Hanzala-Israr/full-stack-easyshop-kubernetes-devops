# Use Node.js 18 Bullseye as a stable runtime base
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# Copy everything from the host workspace straight into the image
COPY . .

# Set target environment parameters
ENV NODE_ENV=development

# RUN PURE JAVASCRIPT: No symlinks, no preloads, no compiler conflicts
CMD ["node", "scripts/migrate-data.js"]
