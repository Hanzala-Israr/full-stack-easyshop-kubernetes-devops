# Use Node.js 18 Bullseye as a stable, production-ready base
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# 1. Copy package definitions first to maximize Docker layer caching stability
COPY package*.json tsconfig.json ./

# 2. Force install production dependencies and global script runners explicitly
RUN npm install --legacy-peer-deps && \
    npm install -g ts-node typescript @types/node

# 3. Copy the remaining scripts and mapping configurations
COPY scripts ./scripts
COPY .db ./.db

# Set target deployment parameters
ENV NODE_ENV=development

# Execute migrations using the local compiled node environment paths
CMD ["ts-node", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
