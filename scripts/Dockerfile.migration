# Use Node.js 18 Bullseye as a stable runtime base
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# 1. Copy the unignored folder. Docker will see this perfectly!
COPY migration_modules ./node_modules

# 2. Copy the compiled script and mapping schema directories
COPY scripts/migrate-data.js ./scripts/migrate-data.js
COPY .db ./.db

# Set target environment parameters
ENV NODE_ENV=development

# RUN PURE JAVASCRIPT: Ready to run natively
CMD ["node", "scripts/migrate-data.js"]
