# Use Node.js 18 Bullseye as a stable runtime base
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# Copy everything from the host workspace straight into the image
COPY . .

# Set target environment parameters
ENV NODE_ENV=development

# FAIL-PROOF EXECUTION: Uses the core node binary and registers ts-node explicitly 
# from your copied local node_modules folder instead of using the broken symlink
CMD ["node", "-r", "./node_modules/ts-node/register", "scripts/migrate-data.ts"]
