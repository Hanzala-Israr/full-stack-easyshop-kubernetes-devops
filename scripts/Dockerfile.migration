# Use Node.js 18 Bullseye as a stable runtime base
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# 1. Copy everything from the host workspace straight into the image
# This automatically brings over the node_modules that Jenkins just successfully built!
COPY . .

# 2. Globally install ts-node inside the container image using a safe, fallback path 
# instead of a live network install
ENV PATH /app/node_modules/.bin:$PATH
ENV NODE_ENV=development

# 3. Explicitly execute using the local binary directly from your node_modules
CMD ["./node_modules/.bin/ts-node", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
