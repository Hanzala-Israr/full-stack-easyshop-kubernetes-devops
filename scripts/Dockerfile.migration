# Use Node.js 18 Bullseye as a pure runtime base
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# Copy the entire workspace (including the pre-installed node_modules from the host)
COPY . .

# Set environment variables
ENV NODE_ENV=development

# Command to run migration
CMD ["npx", "ts-node", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
